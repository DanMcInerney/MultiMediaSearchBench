[
 "<codex>",
 "exec",
 "--json",
 "--skip-git-repo-check",
 "--ignore-user-config",
 "--ignore-rules",
 "--strict-config",
 "-m",
 "gpt-6.1-terra",
 "-c",
 "sandbox_mode=workspace-write",
 "-c",
 "approval_policy=never",
 "-c",
 "web_search=disabled",
 "-c",
 "skills.include_instructions=false",
 "-c",
 "include_environment_context=true",
 "-c",
 "include_permissions_instructions=true",
 "-c",
 "include_collaboration_mode_instructions=false",
 "-c",
 "include_apps_instructions=false",
 "-c",
 "sandbox_workspace_write.network_access=false",
 "-c",
 "windows.sandbox=unelevated",
 "-c",
 "shell_environment_policy.inherit=core",
 "-c",
 "shell_environment_policy.exclude=['PATH']",
 "-c",
 "model_reasoning_effort=medium",
 "-c",
 "model_catalog_json='<RUN>/catalog.json'",
 "-c",
 "model_instructions_file='<RUN>/instructions.md'",
 "-c",
 "shell_environment_policy.set.PATH='<BIN>;C:\\Windows\\System32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0'",
 "-c",
 "shell_environment_policy.set.MULTIMEM_HOME='<WORK>/no-mm-home'",
 "--disable",
 "browser_use",
 "--disable",
 "browser_use_external",
 "--disable",
 "browser_use_full_cdp_access",
 "--disable",
 "computer_use",
 "--disable",
 "image_generation",
 "--disable",
 "apps",
 "--disable",
 "plugins",
 "--disable",
 "multi_agent",
 "--disable",
 "multi_agent_v2",
 "--disable",
 "skill_search",
 "--disable",
 "tool_suggest",
 "--disable",
 "goals",
 "--disable",
 "hooks",
 "--disable",
 "workspace_dependencies",
 "--disable",
 "remote_plugin",
 "--disable",
 "sleep_tool",
 "-C",
 "<WORK>",
 "--",
 "-"
]
